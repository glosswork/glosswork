# Volume root: database, attachments, model cache
GW_DATA_DIR=/data

# 'standalone', 'oidc', or 'both'
GW_AUTH_MODE=standalone

# Required when GW_AUTH_MODE is 'oidc' or 'both'. Startup fails fast, naming the
# variable, if either is missing while OIDC is enabled.
GW_OIDC_ISSUER=
GW_OIDC_CLIENT_ID=
GW_OIDC_CLIENT_SECRET=
# Comma-separated Okta groups mapped to the admin role. Membership in any of them
# grants 'admin'; everything else is 'member'. Unset means everyone is 'member'.
GW_OIDC_ADMIN_GROUPS=
# Groups mapped to the 'creator' role: may define their own object types, but
# cannot reach /api/v1/admin/* or /api/v1/principals*. Same shape as the line above;
# unset means nobody. Set this rather than using 'set-role --role creator' on an
# OIDC principal, whose role is re-derived from these groups on every login.
GW_OIDC_CREATOR_GROUPS=
# The ID-token claim carrying group membership. Okta's default is 'groups'.
GW_OIDC_GROUP_CLAIM=groups

# Created on first run in standalone mode when BOTH are set and no admin exists yet.
# A second start is a no-op. With them unset and no admin present, the app starts and
# logs how to create one with 'python -m glosswork.admin create-admin'.
GW_BOOTSTRAP_ADMIN_EMAIL=
GW_BOOTSTRAP_ADMIN_PASSWORD=

# Enables POST /api/v1/bootstrap, where a program that started this container
# exchanges this secret for the first administrator's account and an admin personal
# access token, exactly once. Leave it blank and the endpoint answers
# feature_disabled.
#
# At least 32 characters; generate one with 'openssl rand -base64 32'. Startup fails,
# naming the variable, if it is shorter, if GW_BASE_URL is unset (the handoff returns
# absolute URLs), if GW_AUTH_MODE is 'oidc' (local sign-in is refused there, so the
# account the claim creates could never sign in), or if either GW_BOOTSTRAP_ADMIN_*
# variable above is set beside it (that path creates the admin at startup, which would
# leave every claim refused as already bootstrapped).
#
# It is safe to leave set afterwards: a second claim is refused once the deployment has
# a user. docs/DEPLOYMENT.md section 3 has the call and what to do if its response is
# lost.
GW_BOOTSTRAP_SECRET=

# The credential that opens GET /api/v1/usage, where whoever runs this deployment for
# somebody else reads aggregate counts: records, attachment bytes, people, agent labels,
# and tool calls by name and error code. No field carries tenant content (DD-39,
# FR-P10).
#
# Unset, or blank, means the endpoint is off, and a self-hosted deployment should leave it
# that way. At least 32 characters if set, or the container refuses to start naming this
# variable; generate one with 'openssl rand -base64 32'. Rotation is a restart.
#
# It is not a personal access token and deliberately cannot be one: a workspace admin
# holding an 'admin' PAT is refused this endpoint exactly as an anonymous caller is.
# Present it in an X-Operator-Token header, never in Authorization.
GW_OPERATOR_TOKEN=

# Argon2id cost parameters for local password accounts. The defaults are the
# argon2-cffi library defaults. Note the memory cost is a per-concurrent-hash working
# set: 65536 KiB is 64 MiB held for the ~30 ms a hash or verify takes, which matters
# in a memory-capped container even at this product's scale.
GW_ARGON2_TIME_COST=3
GW_ARGON2_MEMORY_KIB=65536
GW_ARGON2_PARALLELISM=4

# Minimum local-account password length. A length floor only: there are no
# composition rules and no regex.
GW_PASSWORD_MIN_LENGTH=12

GW_EMBEDDING_MODEL=bge-small-en-v1.5
GW_EMBEDDING_ENABLED=true

# Where the embedding model was baked into the image at build time (DD-32). The
# model is never fetched at runtime: this names a directory that already exists,
# and startup fails fast citing this variable when the files are missing while
# embedding is enabled. /app/models is where the image puts them; a source
# checkout points this at <repo>/models, which
# 'uv run python scripts/fetch_model.py' populates.
GW_MODEL_DIR=/app/models

# Per-file attachment size cap, in bytes, checked by AttachmentService (DD-18)
# before anything is stored. An upload over it is refused with validation_failed
# naming this variable. An MCP create_text_attachment call is also bounded by
# GW_MAX_REQUEST_BYTES below, 4 MiB by default, which refuses a larger request
# first, as payload_too_large. An attachment field's max_bytes, where set, is a
# separate check on the total size of the files one record's field references,
# made when that field is written. For the bytes an upload spools to the
# container's temporary directory before either check runs, see
# GW_MAX_REQUEST_BYTES below.
GW_MAX_ATTACHMENT_BYTES=26214400

# How long an upload ticket lives, in seconds (DD-16).
#
# An agent connected over MCP cannot see the bearer token its client authenticates with,
# so it cannot upload a file by itself. create_attachment_upload mints a credential it
# CAN see: write scope, one filename, one route, one use, and this many seconds.
#
# That credential lands in the model's context and therefore in transcripts and logs,
# which is inherent to any design where the agent runs the HTTP request itself. The
# mitigation is blast radius, and this is the largest part of it. Five minutes is long
# enough to read a local file and issue one POST; lengthening it widens exactly the
# window in which a ticket recovered from a log is still live, and nothing else.
#
# The tool refuses outright when GW_BASE_URL is unset, because a relative URL is useless
# to an agent that cannot see this deployment's origin either. Startup warns about that.
GW_UPLOAD_TICKET_TTL_SECONDS=300

# ------------------------------------------------------------------------ input bounds
#
# Every input is bounded and a bad one is a 4xx (DD-18, DD-19).

# Maximum request body on the /api/ surface AND on /mcp: one setting governs both, so
# the two cannot drift and a 413 carries the same envelope on either. 4 MiB is the cap
# the MCP transport enforces by default (the SDK's default), so this makes an existing
# limit explicit rather than introducing a new number.
#
# Two routes are exempt and enforce their own, larger ceiling: the attachment upload
# (GW_MAX_ATTACHMENT_BYTES) and the CSV import (GW_MAX_CSV_IMPORT_BYTES). Neither of
# those in-app caps bounds the bytes Starlette spools to the container's temp directory
# before the route reads them, so set the proxy's client_max_body_size as well;
# docs/DEPLOYMENT.md section 4 gives the directive and says why it is not optional.
GW_MAX_REQUEST_BYTES=4194304

# CSV import ceilings, both refused before a single row is parsed.
GW_MAX_CSV_IMPORT_BYTES=26214400
GW_MAX_CSV_IMPORT_ROWS=20000

# CSV export row ceiling. Export streams, so this bounds work rather than memory. The
# default of 100,000 rows is the number export once enforced as a silent truncation, so no
# export that would have succeeded then fails now. Over the ceiling is a refusal naming
# this variable, never a truncated file.
GW_MAX_CSV_EXPORT_ROWS=100000

# Public URL. Required when GW_AUTH_MODE is 'oidc' or 'both': it is what the OIDC
# redirect_uri is built from, never the inbound request, which removes the whole
# class of proxy-scheme bugs from the redirect (FR-P7).
GW_BASE_URL=

# The workspace's display name, shown at the top of the sidebar (DD-28). Unset
# means the sidebar renders the mark alone: it does not fall back to the product's
# name.
GW_WORKSPACE_NAME=

# debug, info, warning, error, critical
GW_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Browser sessions (DD-9, DD-10)
# ----------------------------------------------------------------------------
# Whether the session cookie carries the Secure attribute. Defaults to true
# deliberately: deriving it from the inbound request's scheme looks correct and
# fails silently behind a TLS-terminating proxy unless GW_TRUSTED_PROXY_IPS below
# names it, so the safe value is the one this deployment gets by not thinking
# about it. Set to false only for local HTTP development.
GW_COOKIE_SECURE=true

# Absolute and idle session lifetimes, both enforced server-side. The cookie
# itself carries no Max-Age.
GW_SESSION_LIFETIME_HOURS=12
GW_SESSION_IDLE_HOURS=8

# Comma-separated addresses of reverse proxies this deployment trusts to set
# X-Forwarded-Proto and X-Forwarded-For (FR-P7). Passed to uvicorn as
# forwarded_allow_ips. The default trusts only loopback; a real deployment behind
# a TLS-terminating proxy must name its actual proxy address here, or
# X-Forwarded-Proto is silently discarded and GW_COOKIE_SECURE's protection is
# undermined at the transport layer even though the setting itself is correct.
GW_TRUSTED_PROXY_IPS=127.0.0.1

# ----------------------------------------------------------------------------
# Login rate limiting (FR-I1)
# ----------------------------------------------------------------------------
# A fixed-window ceiling on POST /api/v1/auth/login, keyed on the (lowercased
# email, source IP) pair. Argon2id's ~33 ms per verification caps a single core
# near 30 guesses/second, which is a speed bump and not a limit, and the
# bootstrap administrator is a local password account and the highest-value
# credential in the deployment. Rejection is 429 with Retry-After, and it is
# identical whether the email is known or unknown.
#
# Note the key is the pair, not the email alone: limiting by email would let an
# attacker lock the real owner out of every address, turning a guessing attempt
# into a denial of service against exactly the account this protects.
GW_LOGIN_MAX_ATTEMPTS=10
#
# A second budget over the same window, keyed on the source address alone
# (DD-14). The pair window above is right as anti-lockout policy, but alone it would
# be the whole limiter: a fresh random email per request opens a fresh bucket every
# time, so one address could buy unlimited Argon2id verifications. This bounds that.
# It is six times the per-account budget so an office behind one address is not
# throttled -- which assumes GW_TRUSTED_PROXY_IPS names your proxy,
# because otherwise every attempt looks like it came from the proxy and the whole
# office shares this one budget. A successful login clears the pair window and
# deliberately does NOT clear this one.
GW_LOGIN_IP_MAX_ATTEMPTS=60
GW_LOGIN_WINDOW_SECONDS=300

# ----------------------------------------------------------------------------
# MCP transport Host allowlist (FR-P7)
# ----------------------------------------------------------------------------
# Extra Host header values the /mcp endpoint accepts, beyond the host implied by
# GW_BASE_URL. Comma-separated; 'host:*' matches any port on that host.
#
# The check enables itself only when the resulting list is non-empty. Leaving
# both this and GW_BASE_URL unset leaves /mcp without a Host check, because the
# validator is an exact-match allowlist and enabling it empty would reject every
# MCP request. Authorization derives from the bearer token, not this header
# (DD-8); this is defense in depth against DNS rebinding, not the access control.
GW_MCP_ALLOWED_HOSTS=

# ----------------------------------------------------------------------------
# Read-only mode (DD-38)
# ----------------------------------------------------------------------------
# 'true' refuses every REST and MCP write with 409 workspace_read_only, while
# reads, search, and export keep working. Five calls stay open: the backup,
# minting and revoking access tokens, changing your own password, and
# deactivating a principal. Sign-in stays open too. Read at startup, so a change
# needs a restart. Must be 'true' or 'false': a blank value refuses startup.
GW_READ_ONLY=false
# Optional. An absolute http(s) URL that a refused write names as where to
# subscribe. Blank means unset, and the refusal names GW_READ_ONLY instead.
# Anything else refuses startup, naming this variable.
GW_SUBSCRIBE_URL=
